# Optional overrides. Copy to .env.local. Defaults come from the studio's Instagram profile.
# Comma-separated Ugandan numbers, e.g. 0755 817178, 0777 017284
NEXT_PUBLIC_CONTACT_PHONES=
# Number that receives "Book an appointment" requests on WhatsApp (default 0755 817178)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_STUDIO_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_STUDIO_HOURS=
# An external booking page; when set, "Book this design" opens it.
NEXT_PUBLIC_BOOKING_URL=
